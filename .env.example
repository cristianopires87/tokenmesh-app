# ── Collector ─────────────────────────────────────────────────────────────────
# Where the SDK sends events. Override in production.
TOKENMESH_COLLECTOR_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — for local dev, no extra setup)
DATABASE_URL=sqlite:///./tokenmesh.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://tokenmesh:tokenmesh@localhost:5432/tokenmesh
